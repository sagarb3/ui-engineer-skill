# Adapt the provider, approved branch, environment, and deploy script before use.
# The approved preview:deploy script must authenticate through provider OIDC,
# deploy the current build, emit its real URL, and document expiry/cleanup.
name: Trusted UI preview

on:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: trusted-ui-preview
  cancel-in-progress: false

jobs:
  preview:
    if: ${{ github.ref == 'refs/heads/main' }}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    environment: preview
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115 # v6.1.1
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .nvmrc
      - run: pnpm install --frozen-lockfile
      - run: pnpm run build
      - run: pnpm run preview:deploy
